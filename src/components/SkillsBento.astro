---
import Section from "./Section.astro";
import { skillCategories } from "../data/skills";
import { homeSections } from "../data/site-content";

const { stack } = homeSections;
---

<Section
  id="skills"
  label={stack.label}
  title={stack.title}
  lead={stack.lead}
  theme="dotted"
  align="center"
>
  <div class="skills-bento">
    {
      skillCategories.map((cat) => (
        <article class="skills-bento-card">
          <h3 class="skills-bento-card__title text-body font-medium">{cat.label}</h3>
          <div class="skills-bento-card__items">
            {cat.items.map((item) => (
              <span class="chip">{item}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Section>
