---
import ProjectWall from "./ProjectWall.astro";
import FeaturedProjects from "./FeaturedProjects.astro";
import ProjectCard from "./ProjectCard.astro";
import { otherProjects } from "../data/projects";
import { homeSections } from "../data/site-content";

const { projects } = homeSections;
---

<section
  id="projects"
  class="projects-flow section-block section-block--dotted section-block--align-center"
  aria-label="Projects"
>
  <div class="section-block__inner container-gutter projects-flow__intro">
    <p class="u-label">{projects.label}</p>
    <h2 class="u-section-head">{projects.title}</h2>
    <p class="section-lead text-body text-ink-muted">{projects.lead}</p>
  </div>
  <div class="projects-flow__showcase">
    <div class="projects-flow__frame">
      <ProjectWall variant="hero" />
      <p class="project-wall-caption text-body text-ink-muted">{projects.wallCaption}</p>
    </div>
  </div>
  <div class="section-block__inner container-gutter">
    <h3 class="projects-flow__subhead text-body font-medium">{projects.featuredHeading}</h3>
    <div id="projects-featured">
      <FeaturedProjects />
    </div>
    {
      otherProjects.length > 0 && (
        <div id="projects-more" class="more-projects">
          <h3 class="more-projects__title text-body font-medium">{projects.moreHeading}</h3>
          <div class="project-grid">
            {otherProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
