---
import { homeSections } from "../data/site-content";

const { hero } = homeSections;
---

<section class="container-gutter hero">
  <p class="hero__eyebrow hero-animate">
    {hero.eyebrow}
  </p>
  <h1 class="hero__title hero-animate u-section-head">
    <span class="block">{hero.headline[0]}</span>
    <span class="block">{hero.headline[1]}</span>
  </h1>
  <p class="hero__subtitle hero-animate hero-animate--delay">{hero.tagline}</p>
  <div class="hero__actions hero-animate hero-animate--delay">
    {
      hero.actions.map((action) =>
        action.variant === "primary" ? (
          <a
            class="btn btn--primary"
            href={action.href}
            target={action.external ? "_blank" : undefined}
            rel={action.external ? "noopener noreferrer" : undefined}
          >
            {action.label} <span aria-hidden="true">→</span>
          </a>
        ) : (
          <a
            class="btn btn--ghost"
            href={action.href}
            target={action.external ? "_blank" : undefined}
            rel={action.external ? "noopener noreferrer" : undefined}
          >
            {action.label}
          </a>
        ),
      )
    }
  </div>
</section>

<style>
  .block {
    display: block;
  }
</style>
