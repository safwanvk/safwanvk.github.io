---
import { profile } from "../data/profile";

const year = new Date().getFullYear();
---

<footer id="contact" class="site-footer">
  <div class="container-gutter site-footer__inner">
    <div class="site-footer__copy">
      <p style="margin: 0 0 0.25rem;">Designed &amp; developed by {profile.name}</p>
      <p style="margin: 0;">© {year}</p>
    </div>
    <div class="site-footer__links">
      <a href={profile.social.github} target="_blank" rel="noopener noreferrer" title="GitHub">
        <img src="/img/social/github.svg" alt="" width="18" height="18" />
        GitHub
      </a>
      <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer" title="LinkedIn">
        <img src="/img/social/linkedin.svg" alt="" width="18" height="18" />
        LinkedIn
      </a>
      <a href={`mailto:${profile.email}`} title="Email">
        <img src="/img/social/email.svg" alt="" width="18" height="18" />
        Email
      </a>
      <a href={profile.social.instagram} target="_blank" rel="noopener noreferrer" title="Instagram">
        <img src="/img/social/instagram.svg" alt="" width="18" height="18" />
        Instagram
      </a>
    </div>
  </div>
</footer>
