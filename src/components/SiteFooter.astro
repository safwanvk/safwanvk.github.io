---
import { profile } from "../data/profile";
import FooterLogoMark from "./FooterLogoMark.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer text-ink" id="contact">
  <div class="container-gutter site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="#top" class="site-footer__logo">
          <FooterLogoMark />
          {profile.footerDisplayName}
        </a>
        <p class="site-footer__tagline text-small text-ink-muted">{profile.footerTagline}</p>
      </div>
      <nav class="site-footer__nav" aria-label="Footer">
        <div class="site-footer__col">
          <p class="site-footer__col-title text-small">Product</p>
          <ul>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#how-i-build">Process</a></li>
            <li><a href="#skills">Features</a></li>
            <li><a href="#experience">Experience</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <p class="site-footer__col-title text-small">Legal</p>
          <ul>
            <li>
              <a href={profile.resumeUrl} target="_blank" rel="noopener noreferrer">Resume</a>
            </li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="site-footer__watermark-band" aria-hidden="true">
      <canvas
        class="site-footer__watermark-canvas"
        aria-hidden="true"
        data-text={profile.footerWatermarkText}
        data-color="rgba(10,10,10,0.4)"></canvas>
    </div>
  </div>
  <div class="site-footer__bar">
    <div class="site-footer__bottom">
      <p class="site-footer__copy text-small text-ink-subtle">© {year} {profile.name}. All rights reserved.</p>
      <div class="site-footer__social">
        <span class="site-footer__social-label text-small text-ink-subtle">Contact us:</span>
        <ul class="site-footer__social-list">
          <li>
            <a href={`mailto:${profile.email}`} title="Email">
              <img src="/img/social/email.svg" alt="" width="20" height="20" />
            </a>
          </li>
          {
            profile.social.instagram && (
              <li>
                <a href={profile.social.instagram} target="_blank" rel="noopener noreferrer" title="Instagram">
                  <img src="/img/social/instagram.svg" alt="" width="20" height="20" />
                </a>
              </li>
            )
          }
          <li>
            <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer" title="LinkedIn">
              <img src="/img/social/linkedin.svg" alt="" width="20" height="20" />
            </a>
          </li>
          <li>
            <a href={profile.social.github} target="_blank" rel="noopener noreferrer" title="GitHub">
              <img src="/img/social/github.svg" alt="" width="20" height="20" />
            </a>
          </li>
          {
            profile.social.twitter && (
              <li>
                <a href={profile.social.twitter} target="_blank" rel="noopener noreferrer" title="X">
                  <img src="/img/social/twitter.svg" alt="" width="20" height="20" />
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
