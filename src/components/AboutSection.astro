---
import Section from "./Section.astro";
import { homeSections } from "../data/site-content";

const { about } = homeSections;
---

<Section id="about" label={about.label} title={about.title} theme="dotted" align="center">
  {
    about.paragraphs.map((paragraph) => (
      <p class="text-body text-ink-muted">
        {paragraph.text}
        {paragraph.link && (
          <>
            <a class="link" href={paragraph.link.href} target="_blank" rel="noopener noreferrer">
              {paragraph.link.label}
            </a>
          </>
        )}
        {paragraph.suffix ?? ""}
      </p>
    ))
  }
  <dl class="about-stats">
    {
      about.stats.map((stat) => (
        <div class="about-stats__item">
          <dt class="about-stats__value">{stat.value}</dt>
          <dd class="about-stats__label text-small text-ink-muted">{stat.label}</dd>
        </div>
      ))
    }
  </dl>
</Section>
