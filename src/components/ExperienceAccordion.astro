---
import { jobs } from "../data/experience";
import type { Job } from "../data/experience";
import { profile } from "../data/profile";

function faqAnswer(job: Job): string {
  const parts = job.highlights.slice(0, 2).filter(Boolean);
  return parts.join(" ");
}
---

<section
  id="experience"
  class="experience-section"
  data-section="dark"
  aria-labelledby="experience-title"
>
  <div class="container-gutter experience-section__inner">
    <div class="experience-section__content">
      <header class="experience-section__header">
        <p class="u-label experience-section__label">Experience</p>
        <h2 id="experience-title" class="u-section-head experience-section__title">Roles & impact</h2>
      </header>

      <ul class="accordion accordion--dark experience-faq" data-accordion-root>
        {
          jobs.map((job, index) => {
            const isFirst = index === 0;
            const triggerId = `experience-trigger-${index}`;
            const panelId = `experience-panel-${index}`;

            return (
              <li class:list={["accordion-item", { "is-open": isFirst }]} data-accordion-item>
                <h3 class="accordion-item__heading">
                  <button
                    type="button"
                    class="accordion-trigger"
                    id={triggerId}
                    data-accordion-trigger
                    aria-expanded={isFirst ? "true" : "false"}
                    aria-controls={panelId}
                  >
                    <span class="accordion-trigger__glyph" aria-hidden="true">
                      <span class="accordion-trigger__glyph-bar accordion-trigger__glyph-bar--h" />
                      <span class="accordion-trigger__glyph-bar accordion-trigger__glyph-bar--v" />
                    </span>
                    <span class="accordion-trigger__question text-body font-medium text-paper">
                      {job.title} at {job.company}
                    </span>
                  </button>
                </h3>
                <div
                  id={panelId}
                  class="accordion-panel experience-faq__panel"
                  role="region"
                  aria-labelledby={triggerId}
                >
                  <div class="accordion-panel__inner">
                    <p class="experience-faq__answer text-body text-paper-65">{faqAnswer(job)}</p>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>

      <p class="experience-section__resume">
        <a class="text-body" href={profile.resumeUrl} target="_blank" rel="noopener noreferrer">
          View full resume <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</section>
