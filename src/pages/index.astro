---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import AboutSection from "../components/AboutSection.astro";
import UseCases from "../components/UseCases.astro";
import ProcessSection from "../components/ProcessSection.astro";
import SkillsBento from "../components/SkillsBento.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import ExperienceAccordion from "../components/ExperienceAccordion.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout>
  <SiteHeader />
  <main class="main-flow">
    <div class="surface-dots hero-band" id="top">
      <Hero />
    </div>
    <AboutSection />
    <UseCases />
    <ProcessSection />
    <SkillsBento />
    <ProjectsSection />
    <ExperienceAccordion />
  </main>
  <SiteFooter />
</BaseLayout>
