---
import "../styles/global.css";
import { profile } from "../data/profile";
import { pageMeta } from "../data/site-content";
interface Props {
  title?: string;
  description?: string;
}

const { title = pageMeta.title, description = pageMeta.description } = Astro.props;

const canonical = profile.siteUrl + Astro.url.pathname;
const ogImage = `${profile.siteUrl}/img/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="800" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/img/emojis/technologist.png" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistPixel-Square.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="dot-grid" aria-hidden="true">
      <canvas class="dot-grid__canvas"></canvas>
    </div>
    <div class="page">
      <slot />
    </div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
